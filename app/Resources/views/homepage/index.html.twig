{% extends 'layout.html.twig' %}

{# Preload LCP image - Homepage Banner #}
{% block lcpPreload %}
    {% set bannerDesktop = asset('/assets/images/banner/minhduy-banner-2.jpg') | imagine_filter('banner_1360_550') %}
    {% set bannerMobile = asset('/assets/images/banner/minhduy-banner-2.jpg') | imagine_filter('banner_768_400') %}
    <link rel="preload" as="image" href="{{ bannerDesktop }}" media="(min-width: 800px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ bannerMobile }}" media="(max-width: 799px)" fetchpriority="high">
    {# Preload Local Roboto Condensed Bold for LCP text #}
    <link rel="preload" href="{{ asset('build/fonts/RobotoCondensed-Bold.ttf') }}" as="font" type="font/ttf" crossorigin>
{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:image" content="{{ absolute_url(convert_images.webpConvert2(asset('/assets/images/xaydungminhduy-2.jpg'), '')) }}" />
    <meta property="og:image:alt" content="{{ get_setting('siteName') }}" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
{% endblock %}

{% block body %}
    <main class="wrapper-container">
        {{ include('news/components/listPrices.html.twig') }}

        <section class="why-choose-us-section">
            <div class="container">
                <div class="section-header">
                    <h1 class="section-title">Xây Dựng Minh Duy</h1>
                    <p class="section-subtitle">Công ty Xây Dựng Minh Duy xin kính chào Quý khách hàng. Cảm ơn Quý khách hàng đã quan tâm tới dịch vụ xây dựng của công ty chúng tôi.</p>
                </div>
                
                <div class="commitment-header">
                    <h2 class="commitment-title">Cam Kết Của Chúng Tôi</h2>
                    <div class="title-decoration">
                        <span class="line"></span>
                        <i class="fas fa-home"></i>
                        <span class="line"></span>
                    </div>
                </div>

                <div class="row commitment-grid">
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-handshake"></i>
                            </div>
                            <div class="card-content">
                                <h3>Không Bán Thầu</h3>
                                <p>Chúng tôi cam kết không bán thầu, công ty tự thiết kế và thi công trực tiếp mọi công trình.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="card-content">
                                <h3>Không Dùng Hàng Giả</h3>
                                <p>Chúng tôi cam kết không dùng hàng giả, hàng kém chất lượng trong quá trình thi công.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="card-content">
                                <h3>Thi Công Đúng Tiến Độ</h3>
                                <p>Chúng tôi cam kết thi công đúng tiến độ đề ra, đảm bảo chất lượng công trình.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                            <div class="card-content">
                                <h3>Báo Giá Miễn Phí</h3>
                                <p>Báo giá xây dựng nhà phố, biệt thự, sửa chữa nhà miễn phí, nhanh chóng, tận nơi 24/7.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-tags"></i>
                            </div>
                            <div class="card-content">
                                <h3>Giá Cả Cạnh Tranh</h3>
                                <p>Bảng báo giá xây dựng, sửa chữa nhà hợp lý, rõ ràng từng hạng mục, cạnh tranh.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-users-cog"></i>
                            </div>
                            <div class="card-content">
                                <h3>Đội Ngũ Chuyên Nghiệp</h3>
                                <p>Đội ngũ kiến trúc sư, kỹ sư, tổ thợ chuyên nghiệp với nhiều năm kinh nghiệm.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-award"></i>
                            </div>
                            <div class="card-content">
                                <h3>Cam Kết Bảo Hành</h3>
                                <p>Chúng tôi luôn cam kết bảo hành công trình thi công lâu dài, đồng hành cùng khách hàng.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-lightbulb"></i>
                            </div>
                            <div class="card-content">
                                <h3>Sáng Tạo Thiết Kế</h3>
                                <p>Những kỹ sư thiết kế kiến trúc và nội thất có kinh nghiệm sẽ đưa đến ý tưởng sáng tạo.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="commitment-card">
                            <div class="card-icon">
                                <i class="fas fa-check-double"></i>
                            </div>
                            <div class="card-content">
                                <h3>Không Phát Sinh Phí</h3>
                                <p>Chúng tôi cam kết không phát sinh phí trong suốt quá trình xây dựng công trình.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row stats-row">
                    <div class="col-md-3 col-6">
                        <div class="stat-item">
                            <div class="stat-number">10<span>+</span></div>
                            <div class="stat-label">Năm kinh nghiệm</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="stat-item">
                            <div class="stat-number">500<span>+</span></div>
                            <div class="stat-label">Công trình</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="stat-item">
                            <div class="stat-number">100<span>%</span></div>
                            <div class="stat-label">Khách hài lòng</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="stat-item">
                            <div class="stat-number">5<span>★</span></div>
                            <div class="stat-label">Đánh giá</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {% for blockOnHomepage in blocksOnHomepage %}
            {% if blockOnHomepage.category.getParentcat() == 'root' %}
                {% set linkCat = path('news_category', {'level1': blockOnHomepage.category.getUrl() }) %}
            {% else %}
                {% set linkCat = path('list_category', {'level1': blockOnHomepage.category.getParentcat().getUrl(), 'level2': blockOnHomepage.category.getUrl() }) %}
            {% endif %}
            {% if blockOnHomepage.category.getId() != 10 and blockOnHomepage.category.getId() != 11 and blockOnHomepage.category.getId() != 12 %}
                <section class="service-block {% if loop.index is odd %}bg-light{% endif %}">
                    <div class="container">
                        <div class="section-heading">
                            <h2 class="heading-title">
                                <a href="{{ linkCat }}" title="{{ blockOnHomepage.category.getName() }}">{{ blockOnHomepage.category.getName() }}</a>
                            </h2>
                            <div class="heading-decoration">
                                <span class="line"></span>
                                <i class="fas fa-home"></i>
                                <span class="line"></span>
                            </div>
                            <p class="heading-desc">{{ blockOnHomepage.description }}</p>
                        </div>

                        <div class="service-grid">
                            {% for row in blockOnHomepage.posts %}
                                {{ include('news/components/itemsGridHomepage.html.twig') }}
                            {% endfor %}
                        </div>
                        
                        <div class="section-footer">
                            <a href="{{ linkCat }}" class="btn-view-more" title="Xem tất cả {{ blockOnHomepage.category.getName() }}">
                                <span>Xem tất cả</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </section>
            {% else %}
                <section class="project-block">
                    <div class="container">
                        <div class="section-heading">
                            <h2 class="heading-title">
                                <a href="{{ linkCat }}" title="{{ blockOnHomepage.category.getName() }}">{{ blockOnHomepage.category.getName() }}</a>
                            </h2>
                            <div class="heading-decoration">
                                <span class="line"></span>
                                <i class="fas fa-building"></i>
                                <span class="line"></span>
                            </div>
                            <p class="heading-desc">{{ blockOnHomepage.description }}</p>
                        </div>

                        <div class="project-slider">
                            <div class="bxslider">
                                {% for row in blockOnHomepage.posts %}
                                    {{ include('news/components/itemsGridSlide.html.twig') }}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </main>
{% endblock %}

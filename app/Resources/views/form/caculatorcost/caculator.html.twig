{% extends 'layout.html.twig' %}

{% block title %}{{ post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle() }}{% endblock %}
{% block description %}{{ post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription() }}{% endblock %}
{% block keyword %}{{ post.getPageKeyword() }}{% endblock %}

{% block body %}
    {# Hero Section #}
    <section class="calculator-hero">
        <div class="container">
            <div class="calculator-hero-content">
                {{ include('news/components/breadcrumbs.html.twig') }}
                <h1 class="calculator-hero-title">
                    <i class="fas fa-calculator"></i>
                    Dự Toán Chi Phí Xây Dựng
                </h1>
                <p class="calculator-hero-desc">Công cụ tính toán chi phí xây dựng nhà chính xác, miễn phí. Giúp bạn lập kế hoạch tài chính cho ngôi nhà mơ ước.</p>
            </div>
        </div>
    </section>

    {# Main Content #}
    <section class="calculator-section costs">
        <div class="container">
            <div class="row">
                {# Calculator Form #}
                <div class="col-lg-8">
                    <div class="calculator-card">
                        <div class="calculator-card-header">
                            <div class="header-icon">
                                <i class="fas fa-home"></i>
                            </div>
                            <div class="header-text">
                                <h2>Nhập Thông Tin Công Trình</h2>
                                <p>Điền đầy đủ thông tin để nhận báo giá chính xác nhất</p>
                            </div>
                        </div>

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        {{ form_start(form, {'attr': {'class': 'calculator-form'}}) }}
                        
                        {# Step 1: Loại nhà và hình thức #}
                        <div class="form-step">
                            <div class="step-header">
                                <span class="step-number">1</span>
                                <span class="step-title">Loại nhà & Hình thức</span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-building"></i>
                                            {{ form_label(form.type) }}
                                        </label>
                                        {{ form_errors(form.type) }}
                                        {{ form_widget(form.type, {'attr': {'class': 'form-control-modern'}}) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-tools"></i>
                                            {{ form_label(form.method) }}
                                        </label>
                                        {{ form_errors(form.method) }}
                                        {{ form_widget(form.method, {'attr': {'class': 'form-control-modern'}}) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Step 2: Kích thước #}
                        <div class="form-step">
                            <div class="step-header">
                                <span class="step-number">2</span>
                                <span class="step-title">Kích thước công trình</span>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-arrows-alt-h"></i>
                                            {{ form_label(form.wide) }}
                                        </label>
                                        {{ form_errors(form.wide) }}
                                        {{ form_widget(form.wide, {'attr': {'class': 'form-control-modern', 'placeholder': 'VD: 4 hoặc 4.5'}}) }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-arrows-alt-v"></i>
                                            {{ form_label(form.long) }}
                                        </label>
                                        {{ form_errors(form.long) }}
                                        {{ form_widget(form.long, {'attr': {'class': 'form-control-modern', 'placeholder': 'VD: 12 hoặc 12.3'}}) }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-layer-group"></i>
                                            {{ form_label(form.floor) }}
                                        </label>
                                        {{ form_errors(form.floor) }}
                                        {{ form_widget(form.floor, {'attr': {'class': 'form-control-modern'}}) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Step 3: Kết cấu #}
                        <div class="form-step">
                            <div class="step-header">
                                <span class="step-number">3</span>
                                <span class="step-title">Kết cấu móng & mái</span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-cube"></i>
                                            {{ form_label(form.mong) }}
                                        </label>
                                        {{ form_errors(form.mong) }}
                                        {{ form_widget(form.mong, {'attr': {'class': 'form-control-modern'}}) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group-modern">
                                        <label class="form-label-modern">
                                            <i class="fas fa-warehouse"></i>
                                            {{ form_label(form.mai) }}
                                        </label>
                                        {{ form_errors(form.mai) }}
                                        {{ form_widget(form.mai, {'attr': {'class': 'form-control-modern'}}) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Buttons #}
                        <div class="form-actions">
                            {{ form_widget(form.reset, {'attr': {'class': 'btn-reset'}}) }}
                            {{ form_widget(form.caculator, {'attr': {'class': 'btn-calculate'}}) }}
                        </div>
                        {{ form_end(form) }}
                    </div>

                    {# Results Section #}
                    {% if costs is not null %}
                    <div class="calculator-result" id="result">
                        <div class="result-header">
                            <div class="result-icon">
                                <i class="fas fa-chart-pie"></i>
                            </div>
                            <h2>Kết Quả Dự Toán Chi Phí</h2>
                        </div>

                        <div class="result-body">
                            {# Area Breakdown #}
                            <div class="result-section">
                                <h3 class="result-section-title">
                                    <i class="fas fa-ruler-combined"></i>
                                    Chi Tiết Diện Tích
                                </h3>
                                <div class="result-grid">
                                    <div class="result-item">
                                        <span class="result-label">Diện tích tầng trệt</span>
                                        <span class="result-value">{{ costs.area }} m²</span>
                                    </div>
                                    {% if costs.floor > 1 %}
                                        {% for i in range(1, costs.floor - 1) %}
                                        <div class="result-item">
                                            <span class="result-label">Diện tích tầng {{ i }}</span>
                                            <span class="result-value">{{ costs.area }} m²</span>
                                        </div>
                                        {% endfor %}
                                    {% endif %}
                                    <div class="result-item">
                                        <span class="result-label">{{ costs.titleMong }}</span>
                                        <span class="result-value">{{ costs.areaMong }} m²</span>
                                    </div>
                                    <div class="result-item">
                                        <span class="result-label">{{ costs.titleMai }}</span>
                                        <span class="result-value">{{ costs.areaMai }} m²</span>
                                    </div>
                                    <div class="result-item result-item-highlight">
                                        <span class="result-label">Tổng diện tích xây dựng</span>
                                        <span class="result-value">{{ costs.areaTotal }} m²</span>
                                    </div>
                                </div>
                            </div>

                            {# Cost Breakdown #}
                            <div class="result-section">
                                <h3 class="result-section-title">
                                    <i class="fas fa-money-bill-wave"></i>
                                    Chi Phí Xây Dựng
                                </h3>
                                <div class="result-grid">
                                    <div class="result-item">
                                        <span class="result-label">{{ costs.title }}</span>
                                        <span class="result-value">{{ costs.cost|number_format(0, '.', ',') }} đ/m²</span>
                                    </div>
                                </div>
                            </div>

                            {# Total Cost #}
                            <div class="result-total">
                                <div class="total-label">
                                    <i class="fas fa-coins"></i>
                                    Chi Phí Dự Kiến
                                </div>
                                <div class="total-value">
                                    {{ costs.costTotal|number_format(0, '.', ',') }} <sup>đ</sup>
                                </div>
                            </div>

                            {# Note #}
                            <div class="result-note">
                                <i class="fas fa-info-circle"></i>
                                <p><strong>Lưu ý:</strong> {{ costs.note|raw }}</p>
                            </div>
                        </div>

                        {# CTA #}
                        <div class="result-cta">
                            <div class="cta-content">
                                <h3>Nhận Báo Giá Chi Tiết Miễn Phí</h3>
                                <p>Liên hệ ngay để được tư vấn và nhận báo giá xây nhà chính xác nhất!</p>
                            </div>
                            <div class="cta-actions">
                                <a href="tel:{{ get_setting('hotLine2') }}" class="btn-cta btn-cta-phone">
                                    <i class="fas fa-phone-alt"></i>
                                    {{ get_setting('hotLine1') }}
                                </a>
                                <a href="{{ path('news_show', {'slug': 'bao-gia-xay-nha-tron-goi' }) }}" class="btn-cta btn-cta-quote">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                    Xem Báo Giá
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# Post Content #}
                    {% if post.getContents() is not empty %}
                    <div class="calculator-content">
                        <div class="content-header">
                            <h2>Thông Tin Chi Tiết</h2>
                        </div>
                        <div class="content-body">
                            {{ post.getContents()|raw }}
                        </div>
                    </div>
                    {% endif %}
                </div>

                {# Sidebar #}
                <div class="col-lg-4">
                    <div class="calculator-sidebar">
                        {# Quick Info Card #}
                        <div class="sidebar-card">
                            <div class="sidebar-card-header">
                                <i class="fas fa-question-circle"></i>
                                <h3>Hướng Dẫn Sử Dụng</h3>
                            </div>
                            <div class="sidebar-card-body">
                                <ul class="guide-list">
                                    <li>
                                        <span class="guide-step">1</span>
                                        <span>Chọn loại nhà và hình thức xây dựng phù hợp</span>
                                    </li>
                                    <li>
                                        <span class="guide-step">2</span>
                                        <span>Nhập kích thước chiều rộng, chiều dài</span>
                                    </li>
                                    <li>
                                        <span class="guide-step">3</span>
                                        <span>Chọn số tầng, loại móng và mái nhà</span>
                                    </li>
                                    <li>
                                        <span class="guide-step">4</span>
                                        <span>Nhấn "Dự toán chi phí" để xem kết quả</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        {# Contact Card #}
                        <div class="sidebar-card sidebar-card-contact">
                            <div class="sidebar-card-header">
                                <i class="fas fa-headset"></i>
                                <h3>Tư Vấn Miễn Phí</h3>
                            </div>
                            <div class="sidebar-card-body">
                                <p>Liên hệ ngay để được tư vấn chi tiết về chi phí xây dựng</p>
                                <a href="tel:{{ get_setting('hotLine2') }}" class="contact-phone">
                                    <i class="fas fa-phone-alt"></i>
                                    {{ get_setting('hotLine1') }}
                                </a>
                                <a href="mailto:{{ get_setting('emailContact') }}" class="contact-email">
                                    <i class="fas fa-envelope"></i>
                                    {{ get_setting('emailContact') }}
                                </a>
                            </div>
                        </div>

                        {# Benefits Card #}
                        <div class="sidebar-card">
                            <div class="sidebar-card-header">
                                <i class="fas fa-shield-alt"></i>
                                <h3>Cam Kết Của Chúng Tôi</h3>
                            </div>
                            <div class="sidebar-card-body">
                                <ul class="benefits-list">
                                    <li>
                                        <i class="fas fa-check-circle"></i>
                                        <span>Báo giá minh bạch, không phát sinh</span>
                                    </li>
                                    <li>
                                        <i class="fas fa-check-circle"></i>
                                        <span>Thi công đúng tiến độ cam kết</span>
                                    </li>
                                    <li>
                                        <i class="fas fa-check-circle"></i>
                                        <span>Bảo hành công trình 10 năm</span>
                                    </li>
                                    <li>
                                        <i class="fas fa-check-circle"></i>
                                        <span>Đội ngũ kỹ sư giàu kinh nghiệm</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
        <link rel="manifest" href="/site.webmanifest">
        <meta name="msapplication-TileColor" content="#da532c">
        <meta name="theme-color" content="#ffffff">
        
        <meta name="geo.region" content="VI-VN" />
        <meta name="geo.placename" content="Ho Chi Minh, Viet Nam" />
        <meta name="geo.position" content="10.735433;106.700938" />
        <meta name="ICBM" content="10.735433;106.700938" />
        {% block robots %}<meta name="robots" content="index, follow" />{% endblock %}
        <meta name="revisit-after" content="1 days">
        <meta http-equiv="content-language" content="vi">
        
        {# Preload Font Awesome woff2 for faster icon loading #}
        <link rel="preload" href="{{ asset('build/fonts/fa-solid-900.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('build/fonts/fa-brands-400.woff2') }}" as="font" type="font/woff2" crossorigin>
        
        {# LCP Preload - Homepage Banner #}
        {% block lcpPreload %}{% endblock %}

        {% block canonical %}
            {% if app.request.attributes.get('_route') is not null %}
            <link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}"/>
            {% endif %}
        {% endblock %}
        
        <!-- Open Graph data -->
        <meta property="og:locale" content="vi_VN" />
        {% block structuredOpenGraph %}
            <meta property="og:type" content="website" />
            <meta property="og:title" content="{{ block('title') }}" />
            <meta property="og:description" content="{{ block('description') }}" />
        {% endblock %}
        {% if app.request.attributes.get('_route') is not null %}
            <meta property="og:url" content="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}" />
        {% endif %}
        <meta property="og:site_name" content="{{ get_setting('siteName') }}" />
        <meta property="fb:app_id" content="224509460707857" />

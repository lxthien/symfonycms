<header class="site-header">
    <div class="top-bar d-none hidden-xs hidden-sm">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div class="top-bar-left">
                        <span class="top-info"><i class="fas fa-map-marker-alt"></i> {{ get_setting('companyAddress') }}</span>
                        <span class="top-info"><i class="fas fa-clock"></i> Thứ 2 - Thứ 7: 7:30 - 17:30</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="top-bar-right">
                        <div class="social-links">
                            <a target="_blank" href="{{ get_setting('linkToFacebook') }}" title="Facebook" rel="nofollow noreferrer"><i class="fab fa-facebook-f"></i></a>
                            <a target="_blank" href="{{ get_setting('linkToYoutube') }}" title="Youtube" rel="nofollow noreferrer"><i class="fab fa-youtube"></i></a>
                            <a target="_blank" href="{{ get_setting('linkToLinkedin') }}" title="Linkedin" rel="nofollow noreferrer"><i class="fab fa-linkedin-in"></i></a>
                            <a target="_blank" href="{{ get_setting('linkToTwitter') }}" title="Twitter" rel="nofollow noreferrer"><i class="fab fa-twitter"></i></a>
                            <a target="_blank" href="{{ get_setting('linkToGooglePlus') }}" title="Pinterest" rel="nofollow noreferrer"><i class="fab fa-pinterest-p"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="main-header d-none hidden-xs hidden-sm">
        <div class="container">
            <div class="row">
                <div class="col-md-3" id="logo_top">
                    <div id="logo">
                        <a href="{{ path('homepage') }}" title="{{ get_setting('siteName') }}">
                            <img alt="{{ get_setting('siteName') }}" src="{{ asset(convert_images.webpConvert2(asset('/assets/images/logo.png'), '')) }}" width="354" height="72" fetchpriority="high" decoding="async">
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="header-contact-info">
                        <div class="contact-item">
                            <div class="contact-icon"><i class="fas fa-phone-alt"></i></div>
                            <div class="contact-text">
                                <span class="label">Hotline 24/7</span>
                                <a href="tel:{{ get_setting('hotLine2') }}" class="value">{{ get_setting('hotLine1') }}</a>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon"><i class="fas fa-envelope"></i></div>
                            <div class="contact-text">
                                <span class="label">Email</span>
                                <a href="mailto:{{ get_setting('emailContact') }}" class="value">{{ get_setting('emailContact') }}</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="header-cta">
                        <a href="{{ path('contact') }}" class="btn-cta"><i class="fas fa-file-invoice"></i> Báo Giá Miễn Phí</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
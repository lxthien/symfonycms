{% if showSlide is defined %}
    <div id="myCarousel" class="carousel slide" data-ride="carousel">
        <!-- Indicators -->
        <ol class="carousel-indicators">
            <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#myCarousel" data-slide-to="1" class=""></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="item active">
                {% set imagePath = asset('/assets/images/banner/minhduy-banner-2.jpg') %}
                {% set imagePathFilter = asset('/assets/images/banner/minhduy-banner-2.jpg') | imagine_filter('banner_1360_550') %}
                {% set imagePathFilterMobile = asset('/assets/images/banner/minhduy-banner-2.jpg') | imagine_filter('banner_768_400') %}
                        
                {% if convert_images.fileExists(imagePath) == false %}
                    {% set imagePath = imagePath | imagine_filter('banner_1360_550') %}
                    {% set imagePathMobile = imagePath | imagine_filter('banner_768_400') %}
                {% else %}
                    {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
                    {% set imagePathMobile = convert_images.webpConvert(imagePathFilterMobile, '', true) %}
                {% endif %}
                <picture>
                    <source
                        srcset="{{ imagePathMobile != false ? absolute_url(imagePathMobile) : absolute_url(imagePathFilterMobile) }}"
                        media="(max-width: 799px)" />
                    <source
                        srcset="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePath) }}"
                        media="(min-width: 800px)" />
                    <img
                        src="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePath) }}"
                        alt="Chuyên thi công xây nhà trọn gói tại TP HCM"
                        width="1360"
                        height="550"
                        fetchpriority="high"
                        decoding="async" />
                </picture>
                <div class="carousel-overlay"></div>
                <div class="container">
                    <div class="carousel-caption">
                        <span class="caption-badge">Uy tín - Chất lượng - Giá tốt</span>
                        <h2 class="caption-title">Xây Dựng Nhà Trọn Gói</h2>
                        <p class="caption-desc">Công ty chuyên thi công xây nhà trọn gói tại TP.HCM với hơn 10 năm kinh nghiệm</p>
                        <div class="caption-actions">
                            <a href="{{ path('news_show', {'slug': 'bao-gia-xay-nha-tron-goi' }) }}" class="btn-slide-cta">
                                <i class="fas fa-calculator"></i> Xem bảng giá
                            </a>
                            <a href="{{ path('contact') }}" class="btn-slide-outline">
                                <i class="fas fa-phone-alt"></i> Liên hệ tư vấn
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="item">
                {% set imagePath = asset('/assets/images/banner/minhduy-banner-3.jpg') %}
                {% set imagePathFilter = asset('/assets/images/banner/minhduy-banner-3.jpg') | imagine_filter('banner_1360_550') %}
                {% set imagePathFilterMobile = asset('/assets/images/banner/minhduy-banner-3.jpg') | imagine_filter('banner_768_400') %}
                        
                {% if convert_images.fileExists(imagePath) == false %}
                    {% set imagePath = imagePath | imagine_filter('banner_1360_550') %}
                    {% set imagePathMobile = imagePath | imagine_filter('banner_768_400') %}
                {% else %}
                    {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
                    {% set imagePathMobile = convert_images.webpConvert(imagePathFilterMobile, '', true) %}
                {% endif %}
                <picture>
                    <source
                        srcset="{{ imagePathMobile != false ? absolute_url(imagePathMobile) : absolute_url(imagePathFilterMobile) }}"
                        media="(max-width: 799px)" />
                    <source
                        srcset="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePath) }}"
                        media="(min-width: 800px)" />
                    <img
                        src="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePath) }}"
                        alt="Thi công nhà phố, biệt thự"
                        width="1360"
                        height="550"
                        loading="lazy" />
                </picture>
                <div class="carousel-overlay"></div>
                <div class="container">
                    <div class="carousel-caption">
                        <span class="caption-badge">Thiết kế - Thi công - Hoàn thiện</span>
                        <h2 class="caption-title">Nhà Phố & Biệt Thự</h2>
                        <p class="caption-desc">Thiết kế và thi công nhà phố, biệt thự cao cấp theo phong cách hiện đại</p>
                        <div class="caption-actions">
                            <a href="{{ path('list_category', {'level1': 'du-an', 'level2': 'xay-moi' }) }}" class="btn-slide-cta">
                                <i class="fas fa-images"></i> Xem dự án
                            </a>
                            <a href="tel:0982969379" class="btn-slide-outline">
                                <i class="fas fa-phone-alt"></i> 0982.969.379
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a class="left carousel-control" href="#myCarousel" role="button" data-slide="prev">
            <span class="control-icon" aria-hidden="true"><i class="fas fa-chevron-left"></i></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#myCarousel" role="button" data-slide="next">
            <span class="control-icon" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
{% endif %}
{% extends 'layout.html.twig' %}

{% block title %}{{ (category.getPageTitle() is not null ? category.getPageTitle() : category.getName())|replace({'%YEAR%': "now"|date('Y')}) }}{% endblock %}
{% block description %}{{ (category.getPageDescription() is not null ? category.getPageDescription() : category.getName())|replace({'%YEAR%': "now"|date('Y')}) }}{% endblock %}
{% block keyword %}{{ category.getPageKeyword() }}{% endblock %}

{% set imagePathFilter = (vich_uploader_asset(category, 'imageFile') ? vich_uploader_asset(category, 'imageFile') : asset('/assets/images/xaydungminhduy-2.jpg')) | imagine_filter('news_share_800_420') %}

{% block structuredOpenGraph %}
    {% if category.getSchemaMarkup() == null %}
        <meta property="og:type" content="object" />
        <meta property="og:title" content="{{ (category.getPageTitle() is not null ? category.getPageTitle() : category.getName())|replace({'%YEAR%': "now"|date('Y')}) }}" />
        <meta property="og:description" content="{{ (category.getPageDescription() is not null ? category.getPageDescription() : category.getName())|replace({'%YEAR%': "now"|date('Y')}) }}" />
        <meta property="og:image" content="{{ absolute_url(imagePathFilter) }}" />
        <meta property="og:image:alt" content="{{ (category.getPageTitle() is not null ? category.getPageTitle() : category.getName())|replace({'%YEAR%': "now"|date('Y')}) }}" />
        <meta property="og:image:width" content="800" />
        <meta property="og:image:height" content="420" />
        {% if pagination.currentPageNumber == 1 and pagination.pageCount > 1 %}
            <link rel="next" href="{{ baseUrl ~ '/' ~ (pagination.currentPageNumber + 1) }}" />
        {% endif %}
        {% if pagination.currentPageNumber > 1 and pagination.currentPageNumber < pagination.pageCount %}
            {% if pagination.currentPageNumber - 1 == 1 %}
            <link rel="prev" href="{{ baseUrl }}" />
            {% else %}
            <link rel="prev" href="{{ baseUrl ~ '/' ~ (pagination.currentPageNumber - 1) }}" />
            {% endif %}
            <link rel="next" href="{{ baseUrl ~ '/' ~ (pagination.currentPageNumber + 1) }}" />
        {% endif %}
        {% if pagination.currentPageNumber == pagination.pageCount and pagination.pageCount > 1 %}
            {% if pagination.currentPageNumber - 1 == 1 %}
            <link rel="prev" href="{{ baseUrl }}" />
            {% else %}
            <link rel="prev" href="{{ baseUrl ~ '/' ~ (pagination.currentPageNumber - 1) }}" />
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block structuredReview %}
    {% if category.getSchemaMarkup() != null %}
        {{ category.getSchemaMarkup()|raw }}
    {% endif %}
{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ baseUrl }}"/>
{% endblock %}

{% block body %}
    {# breadcrumbs #}
    {{ include('news/components/breadcrumbs.html.twig',
        { type: 'category', title: (category.getTitleLandingPage() != null ? category.getTitleLandingPage() : category.getName()), description: category.getDescription() })
    }}
    
    {% if category.getContent() == null %}
        {# Category List View - No Landing Content #}
        <div class="container wrapper-container">
            <div class="row category-list-items">
                <div class="col-12 col-md-12 col-lg-12">
                    {# List item on this page #}
                    {% if pagination|length > 0  %}
                        {# Sort items #}
                        {% if get_setting('isShowSortOnCategory') %}
                            {{ include('news/components/sort.html.twig') }}
                        {% endif %}

                        <div class="list-news-items">
                            <div class="row">
                                {% for row in pagination %}
                                    {{ include('news/components/itemsGrid.html.twig') }}
                                {% endfor %}
                            </div>
                        </div>

                        {# Pagination #}
                        {{ include('news/components/pagination.html.twig') }}
                    {% else %}
                        {{ include('news/components/noRecord.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        {# Landing Page View - Has Content #}
        <div class="landing-page">
            {# Main Content Section #}
            <section class="landing-content-section">
                <div class="container">
                    <div class="landing-content-wrapper">
                        <div class="category-content">
                            {{ category.getContent()|raw }}
                        </div>
                    </div>
                </div>
            </section>

            {# CTA Section #}
            <section class="landing-cta-section">
                <div class="container">
                    <div class="cta-box">
                        <div class="cta-content">
                            <h3 class="cta-title">
                                <i class="fas fa-phone-volume"></i>
                                Liên hệ tư vấn miễn phí
                            </h3>
                            <p class="cta-text">Gọi ngay cho chúng tôi để được tư vấn và báo giá nhanh nhất!</p>
                        </div>
                        <div class="cta-actions">
                            <a href="tel:{{ get_setting('hotLine1') }}" class="btn-cta btn-cta-phone">
                                <i class="fas fa-phone-alt"></i>
                                <span>{{ get_setting('hotLine1') }}</span>
                            </a>
                            <a href="{{ path('contact') }}" class="btn-cta btn-cta-contact">
                                <i class="fas fa-envelope"></i>
                                <span>Gửi yêu cầu báo giá</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            {# Related Posts Section - if has child categories with posts #}
            {% if pagination|length > 0 %}
            <section class="landing-related-section">
                <div class="container">
                    <div class="section-header">
                        <h2 class="section-title">
                            <i class="fas fa-newspaper"></i>
                            Bài viết liên quan
                        </h2>
                    </div>
                    <div class="list-news-items">
                        <div class="row">
                            {% for row in pagination %}
                                {{ include('news/components/itemsGrid.html.twig') }}
                            {% endfor %}
                        </div>
                    </div>
                    {# Pagination #}
                    {{ include('news/components/pagination.html.twig') }}
                </div>
            </section>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
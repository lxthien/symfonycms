{% if post.getTags()|length > 0 %}
    <div class="post-tags">
        <div class="tags-label">
            <i class="fas fa-tags"></i>
            <span>Tags:</span>
        </div>
        <div class="tags-list">
            {% for tag in post.getTags() %}
                <a href="{{ path('tags', {'slug': tag.getUrl() }) }}" class="tag-item" title="{{ tag.getName() }}" target="_blank" rel="noopener">{{ tag.getName() }}</a>
            {% endfor %}
        </div>
    </div>
{% endif %}
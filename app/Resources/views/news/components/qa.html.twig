{% if qAs is not null %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
                {% for qA in qAs %}
                {
                "@type": "Question",
                "name": "{{ qA.question }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ qA.answer }}"
                }
                }{{ loop.index == qAs|length ? '':','}}
                {% endfor %}
            ]
        }
    </script>
    <div class="faq-section">
        <h2 class="section-title">
            <i class="fas fa-question-circle"></i>
            <span>Những câu hỏi thường gặp</span>
        </h2>
        <div class="faq-list">
            {% for qA in qAs %}
            <div class="faq-item">
                <input type="checkbox" id="faq-{{ loop.index }}" checked>
                <label for="faq-{{ loop.index }}" class="faq-question">
                    <span class="question-text">{{ qA.question }}</span>
                    <i class="fas fa-chevron-down faq-icon"></i>
                </label>
                <div class="faq-answer">
                    <p>{{ qA.answer }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
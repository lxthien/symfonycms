<ul class="recent-posts-list">
    {% for row in posts|slice(0, 5) %}
        {% set imagePath = (vich_uploader_asset(row, 'imageFile') ? vich_uploader_asset(row, 'imageFile') : asset('assets/images/no-image.png')) %}
        {% set imagePathFilter = (vich_uploader_asset(row, 'imageFile') ? vich_uploader_asset(row, 'imageFile') : asset('assets/images/no-image.png')) | imagine_filter('news_70_50') %}
                                
        {% if convert_images.fileExists(imagePath) == false %}
            {% set imagePath = imagePath | imagine_filter('news_406_280') %}
        {% else %}
            {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
        {% endif %}
        <li class="recent-post-item">
            <a href="{{ path('news_show', {'slug': row.getUrl() }) }}" class="recent-post-link" title="{{ row.getTitle() }}">
                <div class="recent-post-thumb">
                    <img
                        class="lazyload"
                        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                        data-src="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePathFilter) }}"
                        alt="{{ row.getTitle() }}"
                        width="80"
                        height="60" />
                </div>
                <div class="recent-post-info">
                    <h4 class="recent-post-title">{{ row.getTitle()|length > 55 ? row.getTitle()|slice(0, 55) ~ '...' : row.getTitle() }}</h4>
                    <span class="recent-post-date"><i class="far fa-clock"></i> {{ row.getUpdatedAt()|date('d/m/Y') }}</span>
                </div>
            </a>
        </li>
    {% endfor %}
</ul>
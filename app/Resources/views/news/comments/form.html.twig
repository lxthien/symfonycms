<div class="comment-form-section">
    <div id="respond" class="comment-respond">
        <h3 class="section-title">
            <i class="fas fa-comment-alt"></i>
            <span>{{ 'comment.leave_your_comment_below'|trans }}</span>
        </h3>
        <p class="comment-response" id="comment-response"></p>
        {{ form_start(form, {'attr': {'id': 'form-comment', 'class': 'comment-form'}}) }}
            {{ form_errors(form) }}
            <div class="form-group">
                {{ form_label(form.content, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.content) }}
                {{ form_widget(form.content, {'attr': {'class': 'form-control form-textarea', 'rows': '4', 'placeholder': 'Nhập nội dung bình luận...'}}) }}
            </div>
            <div class="form-row">
                <div class="form-group half">
                    {{ form_label(form.author, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_errors(form.author) }}
                    {{ form_widget(form.author, {'attr': {'class': 'form-control', 'placeholder': 'Tên của bạn'}}) }}
                </div>
                <div class="form-group half">
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_errors(form.phone) }}
                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Số điện thoại'}}) }}
                </div>
            </div>
            <div class="form-actions">
                {{ form_widget(form.send, {'attr': {'class': 'btn-submit'}}) }}
            </div>
        {{ form_end(form) }}
    </div>
</div>
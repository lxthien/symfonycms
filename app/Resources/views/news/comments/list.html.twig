{% if comments|length > 0 %}
    <div class="comments-section" id="list-comments">
        <h3 class="section-title">
            <i class="fas fa-comments"></i>
            <span>{{ 'comments.count' | trans({ '%count%': comments|length }) }}</span>
        </h3>
        <div class="comments-list">
            {% for comment in comments %}
                {% if comment.getCommentId is null %}
                {% set userPath = asset('/assets/images/user.png') | imagine_filter('user') %}
                <div class="comment-item {{ loop.first ? 'first' : '' }}" id="comment-{{ comment.getId() }}">
                    <div class="comment-avatar">
                        <img
                            src="{{ absolute_url(convert_images.webpConvert(userPath, '', true)) }}"
                            alt="{{ comment.getAuthor() }}"
                            loading="lazy" />
                    </div>
                    <div class="comment-body">
                        <div class="comment-header">
                            <span class="comment-author">{{ comment.getAuthor() }}</span>
                        </div>
                        <div class="comment-content">{{ comment.getContent()|raw }}</div>
                        <a class="comment-reply-btn" id="comment-reply" href="#" data-post-id="{{ comment.getId() }}">
                            <i class="fas fa-reply"></i> {{ 'comment.reply'|trans }}
                        </a>
                        
                        {% for replyComment in comments %}
                            {% if replyComment.getCommentId is same as (comment.getId()) %}
                            <div class="comment-reply">
                                <div class="comment-avatar">
                                    <img
                                        src="{{ absolute_url(convert_images.webpConvert(userPath, '', true)) }}"
                                        alt="{{ replyComment.getAuthor() is same as ('Webmaster') ? get_setting('displayNameCommentAs')|raw : replyComment.getAuthor() }}"
                                        loading="lazy" />
                                </div>
                                <div class="comment-body">
                                    <div class="comment-header">
                                        <span class="comment-author">{{ replyComment.getAuthor() is same as ('Webmaster') ? get_setting('displayNameCommentAs')|raw : replyComment.getAuthor() }}</span>
                                    </div>
                                    <div class="comment-content">{{ replyComment.getContent()|raw }}</div>
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endif %}
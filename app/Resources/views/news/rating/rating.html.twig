<div class="post-rating">
    <div class="rating-stars">
        {{ ratingValue|rating }}
    </div>
    <a href="javascript:void(0)" id="rating" class="rating-link">
        {% if rating > 0 %}
            <span class="rating-score">{{ rating }}</span>
            <span class="rating-text">({{ ratingPercent }}%) - {{ ratingCount }} đánh giá</span>
        {% else %}
            <span class="rating-text">Hãy đánh giá bài viết này</span>
        {% endif %}
    </a>
</div>

<div style="display:none">
    <div id="form-rating-container">
        <form action="{{ path('rating') }}" id="form-rating-review" data-news-id="{{ post.getId() }}">
            {{ form_widget(formRating.rating) }}
        </form>
        <p class="rating-message"></p>
    </div>
</div>
{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_news_revision_compare' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">So sánh revision #{{ revision.id }}</strong>
                            <a class="pull-right" href="{{ path('admin_news_edit', {id: news.id}) }}">Quay lại bài viết</a>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">
                                Revision {{ revision.revisionType }} lúc {{ revision.createdAt|date('H:i:s d/m/Y') }}
                                bởi {{ revision.author ? revision.author.name : 'System' }}.
                            </p>

                            {% if diff %}
                                {% for item in diff %}
                                    <div class="revision-diff-block">
                                        <h4>{{ item.label }}</h4>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h5>Revision</h5>
                                                <pre>{{ item.left }}</pre>
                                            </div>
                                            <div class="col-md-6">
                                                <h5>Hiện tại</h5>
                                                <pre>{{ item.right }}</pre>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="alert alert-success">Revision này giống nội dung hiện tại.</div>
                            {% endif %}

                            <form method="post" action="{{ path('admin_news_revision_restore', {id: news.id, revisionId: revision.id}) }}" data-confirmation>
                                <input type="hidden" name="token" value="{{ csrf_token('restore_revision_' ~ revision.id) }}">
                                <button type="submit" class="btn btn-warning" data-toggle="modal" data-target="#confirmationModalRestoreCompare">
                                    <i class="fa fa-history"></i> Khôi phục revision này
                                </button>
                                <a class="btn btn-link" href="{{ path('admin_news_edit', {id: news.id}) }}">Hủy</a>
                            </form>
                            {{ include('admin/news/_restore_confirmation.html.twig', {id: 'RestoreCompare'}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

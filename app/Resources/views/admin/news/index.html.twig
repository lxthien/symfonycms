{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_news_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_news_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.news_list'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <form class="admin-list-filters" method="get" action="{{ path('admin_news_index') }}">
                                <div class="row">
                                    <div class="col-md-4">
                                        <input type="text" name="q" value="{{ filters.q }}" class="form-control" placeholder="Tìm theo tiêu đề, URL, mô tả">
                                    </div>
                                    <div class="col-md-3">
                                        <select name="category" class="form-control">
                                            <option value="">Tất cả danh mục</option>
                                            {% for category in categories %}
                                                <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <select name="status" class="form-control">
                                            <option value="">Tất cả trạng thái</option>
                                            <option value="published" {{ filters.status == 'published' ? 'selected' : '' }}>Đã xuất bản</option>
                                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Bản nháp</option>
                                            <option value="pending_review" {{ filters.status == 'pending_review' ? 'selected' : '' }}>Chờ duyệt</option>
                                            <option value="scheduled" {{ filters.status == 'scheduled' ? 'selected' : '' }}>Đặt lịch</option>
                                            <option value="archived" {{ filters.status == 'archived' ? 'selected' : '' }}>Lưu trữ</option>
                                            <option value="trash" {{ filters.status == 'trash' ? 'selected' : '' }}>Thùng rác</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Lọc</button>
                                        <a href="{{ path('admin_news_index') }}" class="btn btn-link">Xóa lọc</a>
                                    </div>
                                </div>
                            </form>

                            <form id="admin-news-bulk-form" method="post" action="{{ path('admin_news_bulk', app.request.query.all) }}" data-bulk-form>
                                <input type="hidden" name="token" value="{{ csrf_token('bulk_news') }}">
                                <div class="admin-bulk-toolbar">
                                    <select name="bulk_action" class="form-control">
                                        <option value="">Chọn thao tác</option>
                                        <option value="publish">Xuất bản đã chọn</option>
                                        <option value="unpublish">Chuyển nháp đã chọn</option>
                                        <option value="archive">Lưu trữ đã chọn</option>
                                        <option value="trash">Bỏ thùng rác đã chọn</option>
                                        <option value="delete">Xóa vĩnh viễn đã chọn</option>
                                    </select>
                                    <button type="submit" class="btn btn-default">Áp dụng</button>
                                    <span class="text-muted">{{ pagination.getTotalItemCount }} bài viết</span>
                                </div>
                            </form>

                            <table class="table table-striped table-bordered admin-list-table">
                                <thead>
                                    <tr>
                                        <th class="admin-list-check"><input type="checkbox" data-bulk-check-all></th>
                                        <th class="admin-news-image-col">{{ 'label.images'|trans }}</th>
                                        <th class="admin-news-title-col">{{ 'lable.news.title'|trans }}</th>
                                        <th class="admin-news-category-col">{{ 'label.category'|trans }}</th>
                                        <th class="admin-news-status-col">{{ 'label.status'|trans }}</th>
                                        <th class="admin-news-date-col">{{ 'label.published_at'|trans }}</th>
                                        <th class="admin-news-date-col">{{ 'Updated' }}</th>
                                        <th class="admin-news-actions-col">{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in pagination %}
                                        <tr>
                                            <td><input type="checkbox" name="ids[]" value="{{ row.id }}" form="admin-news-bulk-form" data-bulk-check></td>
                                            <td>
                                                <div class="images-container">
                                                    <img src="{{ (vich_uploader_asset(row, 'imageFile') ? vich_uploader_asset(row, 'imageFile') : asset('assets/images/no-image.png')) | imagine_filter('admin_thumb') }}" alt="{{ row.getTitle() }}" width="50" height="50" />
                                                </div>
                                            </td>
                                            <td>
                                                <a class="btn-link" href="{{ path('admin_news_edit', {id: row.id}) }}">{{ row.getTitle() }}</a>
                                                <small class="d-block text-muted">
                                                    URL: {{ row.getUrl() }}
                                                </small>
                                            </td>
                                            <td>
                                                {% for category in row.getCategory() %}
                                                    {{ category.getName() }}{{ loop.last == false ? ', ' : '' }}
                                                {% endfor %}
                                            </td>
                                            <td>
                                                {% set statusColors = {
                                                    'published': 'success',
                                                    'draft': 'secondary',
                                                    'pending_review': 'warning',
                                                    'scheduled': 'info',
                                                    'archived': 'dark',
                                                    'trash': 'danger'
                                                } %}
                                                <span class="badge badge-{{ statusColors[row.getStatus()] | default('secondary') }}">
                                                    {{ row.getStatusLabel() }}
                                                </span>
                                                {% if row.isScheduled() and row.getScheduledAt() %}
                                                    <small class="d-block text-muted mt-1">
                                                        <i class="fa fa-clock-o"></i> {{ row.getScheduledAt() | localizeddate('short', 'short', null, 'Asia/Ho_Chi_Minh') }}
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td>{{ row.getCreatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td>{{ row.getUpdatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td>
                                                <div class="item-actions">
                                                    <a href="{{ path('admin_news_edit', {id: row.id}) }}" class="btn-sm">
                                                        <i class="fa fa-edit" aria-hidden="true"></i>
                                                    </a>
                                                    
                                                    {{ include('admin/news/_delete_form.html.twig', {news: row}, with_context = false) }}
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="8" class="text-center text-muted">Không tìm thấy bài viết.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>

                            <div class="admin-pagination">
                                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v3_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

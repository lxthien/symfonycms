{{ form_start(form, {attr: attr|default({})}) }}
    {{ form_errors(form) }}

    {{ form_row(form.title) }}
    {{ form_row(form.url) }}
    {{ form_row(form.status) }}
    {{ form_row(form.scheduledAt) }}
    {{ form_row(form.editorialNotes) }}
    {{ form_row(form.imageFile) }}

    {{ form_widget(form.mediaImageId) }}
    {{ form_widget(form.albumItems) }}

    {{ include('admin/media/_news_media_fields.html.twig', {
        form: form,
        object: object|default(null),
        album_json: album_json|default('[]'),
    }, with_context = false) }}

    {{ form_row(form.description) }}
    {{ include('admin/content_block/_toolbar.html.twig', {
        target_editor: form.contents.vars.id,
        current_id: object is defined and object ? object.id : 0,
    }, with_context = false) }}
    {{ form_row(form.contents) }}
    {{ form_row(form.ordering) }}
    {{ form_widget(form.categoryPrimary) }}
    {{ include('admin/news/_category_tree_field.html.twig', {
        form: form,
        category_tree: category_tree|default([]),
    }, with_context = false) }}
    {{ form_row(form.tags) }}

    <div class="card-title">
        <h3>{{ 'label.seo'|trans }}</h3>
    </div>
    <hr>

    {{ form_row(form.pageTitle) }}
    {{ form_row(form.pageDescription) }}
    {{ form_row(form.pageKeyword) }}
    {{ form_row(form.isIndex) }}
    {{ form_row(form.isFollow) }}
    {{ form_row(form.autoFulfillAddress) }}
    {{ form_row(form.template) }}
    {{ form_row(form.qa) }}

    {{ include('admin/common/_slug_helper.html.twig', {
        form: form,
        object: object|default(null),
    }) }}

    {{ include('admin/news/_seo_realtime_checklist.html.twig', {
        form: form,
        has_image: object is defined and object.images is defined and object.images,
        check_category: form.category is defined,
    }) }}

    <button type="submit" class="{{ button_css|default("btn btn-primary") }}">
        <i class="fa fa-save" aria-hidden="true"></i> {{ button_label|default('label.create_post'|trans) }}
    </button>

    {% if form.saveAndCreateNew is defined %}
        {{ form_widget(form.saveAndCreateNew, {label: 'label.save_and_create_new', attr: {class: button_css|default('btn btn-primary')}}) }}
    {% endif %}

    {% if include_back_to_home_link|default(false) %}
        <a href="{{ path('admin_news_index') }}" class="btn btn-link">
            <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
        </a>
    {% endif %}

    {{ form_rest(form) }}
{{ form_end(form) }}

{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin-user-password' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Cập nhật mật khẩu: {{ object.username }}</strong>
                        </div>
                        <div class="card-body">
                            {{ form_start(form) }}
                                {{ form_errors(form) }}
                                {{ form_row(form.plainPassword) }}

                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-key" aria-hidden="true"></i> Cập nhật mật khẩu
                                </button>
                                <a href="{{ path('admin_user_index') }}" class="btn btn-link">
                                    <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
                                </a>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

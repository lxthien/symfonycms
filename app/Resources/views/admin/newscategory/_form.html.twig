{{ form_start(form, {attr: attr|default({})}) }}
    {{ form_errors(form) }}
    {{ form_row(form.parentcat) }}
    {{ form_row(form.name) }}
    {{ form_row(form.titleLandingPage) }}
    {{ form_row(form.url) }}
    {{ form_row(form.imageFile) }}
    {{ form_widget(form.mediaImageId) }}

    {% set currentImage = form.vars.data and form.vars.data.images ? vich_uploader_asset(form.vars.data, 'imageFile') : null %}
    <div class="media-field-picker" data-media-field-picker>
        <div class="media-field-preview" data-media-field-preview>
            {% if currentImage %}
                <img src="{{ currentImage }}" alt="{{ form.vars.data.name }}">
            {% else %}
                <span>Chưa chọn ảnh từ Media Library</span>
            {% endif %}
        </div>
        <div class="media-field-actions">
            <button type="button"
                    class="btn btn-outline-primary"
                    data-media-picker-open
                    data-picker-url="{{ path('admin_media_picker') }}"
                    data-target-input="#{{ form.mediaImageId.vars.id }}"
                    data-target-preview="[data-media-field-preview]">
                <i class="fa fa-picture-o"></i> Chọn từ Media Library
            </button>
            <button type="button" class="btn btn-link" data-media-picker-clear data-target-input="#{{ form.mediaImageId.vars.id }}" data-target-preview="[data-media-field-preview]">Bỏ chọn media</button>
        </div>
    </div>

    {{ form_row(form.description) }}
    {{ form_row(form.content) }}
    {{ form_row(form.enable) }}
    {{ form_row(form.sortBy) }}

    <div class="card-title">
        <h3>{{ 'label.seo'|trans }}</h3>
    </div>
    <hr>

    {{ form_row(form.pageTitle) }}
    {{ form_row(form.pageDescription) }}
    {{ form_row(form.pageKeyword) }}
    {{ form_row(form.isIndex) }}
    {{ form_row(form.isFollow) }}
    {{ form_row(form.schemaMarkup) }}

    <button type="submit" class="{{ button_css|default("btn btn-primary") }}">
        <i class="fa fa-save" aria-hidden="true"></i> {{ button_label|default('label.create_post'|trans) }}
    </button>

    {% if form.saveAndCreateNew is defined %}
        {{ form_widget(form.saveAndCreateNew, {label: 'label.save_and_create_new', attr: {class: 'btn btn-primary'}}) }}
    {% endif %}

    {% if include_back_to_home_link|default(false) %}
        <a href="{{ path('admin_newscategory_index') }}" class="btn btn-link">
            <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
        </a>
    {% endif %}

    <div class="modal fade media-picker-modal" id="mediaPickerModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Chọn ảnh từ Media Library</h4>
                </div>
                <div class="modal-body" data-media-picker-content>
                    <div class="text-center text-muted">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>
{{ form_end(form) }}

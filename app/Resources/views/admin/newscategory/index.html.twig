{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_category_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_newscategory_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.categories'|trans }}</strong>
                            <span class="badge badge-primary">{{ totalCategories }}</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-striped table-bordered admin-list-table category-tree-table">
                                <colgroup>
                                    <col class="category-tree-col-name">
                                    <col class="category-tree-col-parent">
                                    <col class="category-tree-col-url">
                                    <col class="category-tree-col-status">
                                    <col class="category-tree-col-date">
                                    <col class="category-tree-col-date">
                                    <col class="category-tree-col-actions">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>{{ 'label.name'|trans }}</th>
                                        <th>{{ 'label.parentcat'|trans }}</th>
                                        <th>{{ 'label.url'|trans }}</th>
                                        <th class="text-center">Status</th>
                                        <th>{{ 'label.published_at'|trans }}</th>
                                        <th>{{ 'Updated' }}</th>
                                        <th class="text-center">{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in categoryTree %}
                                        {% set row = item.category %}
                                        <tr class="{{ item.depth == 0 ? 'category-tree-parent' : 'category-tree-child' }}">
                                            <td class="category-tree-name">
                                                <span class="category-tree-indent" style="--category-depth: {{ item.depth > 0 ? item.depth - 1 : 0 }}"></span>
                                                {% if item.depth > 0 %}
                                                    <i class="fa fa-file-text category-tree-file" aria-hidden="true"></i>
                                                {% else %}
                                                    <i class="fa fa-folder category-tree-folder" aria-hidden="true"></i>
                                                {% endif %}
                                                <a class="btn-link" href="{{ path('admin_news_list_by_category', {categoryId: row.id}) }}">{{ row.getName() }}</a>
                                            </td>
                                            <td>
                                                {% if item.parent %}
                                                    {{ item.parent.name }}
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <code>{{ row.getUrl() }}</code>
                                            </td>
                                            <td class="text-center">
                                                {% if item.hasCycle %}
                                                    <span class="badge badge-danger">Cycle</span>
                                                {% elseif item.isOrphan %}
                                                    <span class="badge badge-warning">Orphan</span>
                                                {% elseif row.getEnable() %}
                                                    <span class="badge badge-success">Online</span>
                                                {% else %}
                                                    <span class="badge badge-secondary">Offline</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ row.getCreatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td>{{ row.getUpdatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td class="text-center">
                                                <div class="item-actions">
                                                    <a href="{{ path('admin_newscategory_edit', {id: row.id}) }}" class="btn-sm btn-edit" title="Edit">
                                                        <i class="fa fa-edit" aria-hidden="true"></i>
                                                    </a>

                                                    {{ include('admin/newscategory/_delete_form.html.twig', {category: row}, with_context = false) }}
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">Chưa có danh mục.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_dashboard_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-1 dashboard-kpi">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="fa fa-newspaper-o text-light"></i>
                                </div>
                                <div class="stat-content dib">
                                    <h4 class="mb-0">
                                        <span class="count">{{ stats.postCount }}</span>
                                    </h4>
                                    <p class="text-light">Bài viết</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-2 dashboard-kpi">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="fa fa-pencil-square-o text-light"></i>
                                </div>
                                <div class="stat-content dib">
                                    <h4 class="mb-0">
                                        <span class="count">{{ stats.draftPostCount }}</span>
                                    </h4>
                                    <p class="text-light">Bài nháp / đang tắt</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-3 dashboard-kpi">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="fa fa-comments-o text-light"></i>
                                </div>
                                <div class="stat-content dib">
                                    <h4 class="mb-0">
                                        <span class="count">{{ stats.pendingCommentCount }}</span>
                                    </h4>
                                    <p class="text-light">Comment chờ duyệt</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-4 dashboard-kpi">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="fa fa-address-book-o text-light"></i>
                                </div>
                                <div class="stat-content dib">
                                    <h4 class="mb-0">
                                        <span class="count">{{ stats.newLeadCount }}</span>
                                    </h4>
                                    <p class="text-light">Lead mới 7 ngày</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-3 col-lg-6">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="ti-files text-primary border-primary"></i>
                                </div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Trang tĩnh</div>
                                    <div class="stat-digit">{{ stats.pageCount }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="ti-folder text-success border-success"></i>
                                </div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Danh mục</div>
                                    <div class="stat-digit">{{ stats.categoryCount }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="ti-alert text-warning border-warning"></i>
                                </div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Lỗi SEO cần xử lý</div>
                                    <div class="stat-digit">{{ stats.seoIssueCount }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card dashboard-mini-card dashboard-index-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib">
                                    <i class="ti-dashboard text-danger border-danger"></i>
                                </div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Điểm SEO TB</div>
                                    <div class="stat-digit">{{ stats.averageSeoScore }}/100</div>
                                </div>
                            </div>
                            <div class="progress progress-xs mt-3" style="height: 5px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: {{ stats.averageSeoScore }}%;" aria-valuenow="{{ stats.averageSeoScore }}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted">{{ stats.recentPublishedCount }} nội dung mới trong 30 ngày</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Top bài viết theo lượt xem</strong>
                            <a class="pull-right" href="{{ path('admin_news_index') }}">Quản lý bài viết</a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                            <table class="table table-striped table-bordered dashboard-table">
                                <thead>
                                    <tr>
                                        <th class="dashboard-table-title">Bài viết</th>
                                        <th class="dashboard-table-number text-center">Lượt xem</th>
                                        <th class="dashboard-table-date text-center">Cập nhật</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for post in topPosts %}
                                        <tr>
                                            <td>
                                                <a href="{{ path('admin_news_edit', {id: post.id}) }}">{{ post.title }}</a>
                                                <small class="d-block text-muted">
                                                    <a href="{{ path('news_show', {slug: post.url}) }}" target="_blank">{{ post.url }}.html</a>
                                                </small>
                                            </td>
                                            <td class="text-center">{{ post.viewCounts|number_format(0, '.', ',') }}</td>
                                            <td class="text-center">{{ post.updatedAt|localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">Chưa có bài viết đã xuất bản.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Lead mới nhất</strong>
                            <a class="pull-right" href="{{ path('admin_contact_index') }}">Xem tất cả</a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                            <table class="table table-striped table-bordered dashboard-table">
                                <thead>
                                    <tr>
                                        <th class="dashboard-table-contact-name">Khách hàng</th>
                                        <th class="dashboard-table-contact">Liên hệ</th>
                                        <th class="dashboard-table-date">Ngày gửi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for lead in recentLeads %}
                                        <tr>
                                            <td>
                                                <strong>{{ lead.name }}</strong>
                                                {% if lead.title %}
                                                    <small class="d-block text-muted">{{ lead.title }}</small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if lead.phone %}
                                                    <a href="tel:{{ lead.phone }}">{{ lead.phone }}</a><br>
                                                {% endif %}
                                                <a href="mailto:{{ lead.email }}">{{ lead.email }}</a>
                                            </td>
                                            <td>{{ lead.createdAt|localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">Chưa có lead nào.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Lỗi SEO cần xử lý</strong>
                            <span class="badge badge-warning pull-right">{{ stats.seoIssueCount }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                            <table class="table table-striped table-bordered dashboard-table">
                                <thead>
                                    <tr>
                                        <th class="dashboard-table-title">Bài viết</th>
                                        <th class="dashboard-table-score text-center">Điểm SEO</th>
                                        <th class="dashboard-table-issues">Vấn đề</th>
                                        <th class="dashboard-table-date text-center">Cập nhật</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in seoIssues %}
                                        <tr>
                                            <td>
                                                <a href="{{ path('admin_news_edit', {id: item.post.id}) }}">{{ item.post.title }}</a>
                                                <small class="d-block text-muted">{{ item.post.url }}.html</small>
                                            </td>
                                            <td class="text-center">
                                                {% set scoreClass = item.score >= 90 ? 'success' : (item.score >= 80 ? 'primary' : (item.score >= 60 ? 'warning' : 'danger')) %}
                                                <span class="badge badge-{{ scoreClass }}">{{ item.score }}/100</span>
                                                <small class="d-block text-muted">{{ item.status }}</small>
                                            </td>
                                            <td>
                                                {% for reason in item.reasons %}
                                                    <span class="badge badge-danger">{{ reason }}</span>
                                                {% endfor %}
                                                {% for recommendation in item.recommendations %}
                                                    <span class="badge badge-warning">{{ recommendation }}</span>
                                                {% endfor %}
                                            </td>
                                            <td class="text-center">{{ item.post.updatedAt|localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">Không phát hiện lỗi SEO cơ bản trong bài đã xuất bản.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_news_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_page_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.page_list'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <form class="admin-list-filters" method="get" action="{{ path('admin_page_index') }}">
                                <div class="row">
                                    <div class="col-md-5">
                                        <input type="text" name="q" value="{{ filters.q }}" class="form-control" placeholder="Tìm theo tiêu đề, URL, mô tả">
                                    </div>
                                    <div class="col-md-3">
                                        <select name="status" class="form-control">
                                            <option value="">Tất cả trạng thái</option>
                                            <option value="published" {{ filters.status == 'published' ? 'selected' : '' }}>Đang bật</option>
                                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Đang tắt</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Lọc</button>
                                        <a href="{{ path('admin_page_index') }}" class="btn btn-link">Xóa lọc</a>
                                    </div>
                                </div>
                            </form>

                            <form id="admin-page-bulk-form" method="post" action="{{ path('admin_page_bulk', app.request.query.all) }}" data-bulk-form>
                                <input type="hidden" name="token" value="{{ csrf_token('bulk_page') }}">
                                <div class="admin-bulk-toolbar">
                                    <select name="bulk_action" class="form-control">
                                        <option value="">Chọn thao tác</option>
                                        <option value="publish">Bật đã chọn</option>
                                        <option value="unpublish">Tắt đã chọn</option>
                                        <option value="delete">Xóa đã chọn</option>
                                    </select>
                                    <button type="submit" class="btn btn-default">Áp dụng</button>
                                    <span class="text-muted">{{ pagination.getTotalItemCount }} trang</span>
                                </div>
                            </form>

                            <table class="table table-striped table-bordered admin-list-table">
                                    <thead>
                                        <tr>
                                            <th class="admin-list-check"><input type="checkbox" data-bulk-check-all></th>
                                            <th>{{ 'label.title'|trans }}</th>
                                            <th>{{ 'label.status'|trans }}</th>
                                            <th>{{ 'label.published_at'|trans }}</th>
                                            <th>{{ 'label.actions'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in pagination %}
                                        <tr>
                                            <td><input type="checkbox" name="ids[]" value="{{ row.id }}" form="admin-page-bulk-form" data-bulk-check></td>
                                            <td>
                                                <a class="btn-link" href="{{ path('admin_page_edit', {id: row.id}) }}">{{ row.getTitle() }}</a>
                                                <small class="d-block text-muted">URL: {{ row.getUrl() }}</small>
                                            </td>
                                            <td>{{ row.getEnable() ? 'Đang bật' : 'Đang tắt' }}</td>
                                            <td>{{ row.getCreatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td>
                                                <div class="item-actions">
                                                    <a href="{{ path('admin_page_edit', {id: row.id}) }}" class="btn-sm">
                                                        <i class="fa fa-edit" aria-hidden="true"></i>
                                                    </a>
                                                    
                                                    {{ include('admin/page/_delete_form.html.twig', {news: row}, with_context = false) }}
                                                </div>
                                            </td>
                                        </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">Không tìm thấy trang.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                            </table>

                            <div class="admin-pagination">
                                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v3_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}

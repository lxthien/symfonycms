{% extends 'layout.html.twig' %}

{% block title %}{{ post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle() }}{% endblock %}
{% block description %}{{ post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription() }}{% endblock %}
{% block keyword %}{{ post.getPageKeyword() }}{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle() }}" />
    <meta property="og:description" content="{{ post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription() }}" />
{% endblock %}

{% block body %}
    {# Hero Section #}
    <div class="contact-hero">
        <div class="container">
            <h1 class="hero-title">Liên hệ với chúng tôi</h1>
            <p class="hero-subtitle">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn</p>
        </div>
    </div>

    <div class="contact-page">
        <div class="container">
            <div class="contact-wrapper">
                {# Contact Info Cards #}
                <div class="contact-info-section">
                    <div class="info-cards">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="info-content">
                                <h3>Địa chỉ văn phòng</h3>
                                <p>{{ get_setting('companyAddress') }}</p>
                            </div>
                        </div>
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div class="info-content">
                                <h3>Hotline</h3>
                                <p><a href="tel:{{ get_setting('hotLine2') }}">{{ get_setting('hotLine1') }}</a> - Mr Minh</p>
                            </div>
                        </div>
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <h3>Email</h3>
                                <p><a href="mailto:{{ get_setting('emailContact') }}">{{ get_setting('emailContact') }}</a></p>
                            </div>
                        </div>
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fas fa-globe"></i>
                            </div>
                            <div class="info-content">
                                <h3>Website</h3>
                                <p><a href="{{ path('homepage') }}" target="_blank">{{ get_setting('companyWebsite') }}</a></p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Contact Form Section #}
                <div class="contact-form-section">
                    <div class="form-container">
                        <div class="form-header">
                            <h2><i class="fas fa-paper-plane"></i> Gửi tin nhắn cho chúng tôi</h2>
                            <p>Điền thông tin bên dưới, chúng tôi sẽ liên hệ lại trong thời gian sớm nhất</p>
                        </div>

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('notice') %}
                            <div class="alert alert-success" role="alert">
                                <i class="fas fa-check-circle"></i> {{ message }}
                            </div>
                            <script>
                                window.dataLayer = window.dataLayer || [];
                                window.dataLayer.push({
                                    'event': 'subscriber'
                                });
                            </script>
                        {% endfor %}

                        {{ form_start(form, {'attr': {'class': 'contact-form', 'id': 'contact-form'}}) }}
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label" for="{{ form.name.vars.id }}">
                                        <i class="fas fa-user"></i> {{ form.name.vars.label|trans }}
                                    </label>
                                    {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nhập họ tên của bạn'}}) }}
                                    {{ form_errors(form.name) }}
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="{{ form.phone.vars.id }}">
                                        <i class="fas fa-phone"></i> {{ form.phone.vars.label|trans }}
                                    </label>
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Nhập số điện thoại'}}) }}
                                    {{ form_errors(form.phone) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="{{ form.email.vars.id }}">
                                    <i class="fas fa-envelope"></i> {{ form.email.vars.label|trans }}
                                </label>
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Nhập địa chỉ email'}}) }}
                                {{ form_errors(form.email) }}
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="{{ form.contents.vars.id }}">
                                    <i class="fas fa-comment-alt"></i> {{ form.contents.vars.label|trans }}
                                </label>
                                {{ form_widget(form.contents, {'attr': {'class': 'form-control', 'placeholder': 'Nhập nội dung tin nhắn...', 'rows': '5'}}) }}
                                {{ form_errors(form.contents) }}
                            </div>
                            <div class="form-group recaptcha-group">
                                {{ form_widget(form.recaptcha) }}
                                {{ form_errors(form.recaptcha) }}
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-submit">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Gửi tin nhắn</span>
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
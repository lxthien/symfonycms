{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_media_upload' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Upload media</strong>
                        </div>
                        <div class="card-body">
                            <div class="media-dropzone" data-media-dropzone data-file-input="#media_upload_files">
                                <div class="media-dropzone-icon"><i class="fa fa-cloud-upload"></i></div>
                                <strong>Kéo thả ảnh/file vào đây</strong>
                                <span>hoặc bấm chọn file bên dưới. Hỗ trợ JPG, PNG, GIF, WebP, PDF.</span>
                            </div>
                            <div class="media-upload-preview" data-media-upload-preview></div>

                            {{ include('admin/media/_form.html.twig', {
                                form: form,
                                button_label: 'Upload'
                            }, with_context = false) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

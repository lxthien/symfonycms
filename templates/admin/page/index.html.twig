{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_news_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_page_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.page_list'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <form class="admin-list-filters" method="get" action="{{ path('admin_page_index') }}">
                                <div class="row">
                                    <div class="col-md-5">
                                        <input type="text" name="q" value="{{ filters.q }}" class="form-control" placeholder="Tìm theo tiêu đề, URL, mô tả">
                                    </div>
                                    <div class="col-md-3">
                                        <select name="status" class="form-control">
                                            <option value="">Tất cả trạng thái</option>
                                            <option value="published" {{ filters.status == 'published' ? 'selected' : '' }}>Đã xuất bản</option>
                                            <option value="pending_review" {{ filters.status == 'pending_review' ? 'selected' : '' }}>Chờ duyệt</option>
                                            <option value="scheduled" {{ filters.status == 'scheduled' ? 'selected' : '' }}>Đặt lịch</option>
                                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Bản nháp</option>
                                            <option value="archived" {{ filters.status == 'archived' ? 'selected' : '' }}>Lưu trữ</option>
                                            <option value="trash" {{ filters.status == 'trash' ? 'selected' : '' }}>Thùng rác</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Lọc</button>
                                        <a href="{{ path('admin_page_index') }}" class="btn btn-link">Xóa lọc</a>
                                    </div>
                                </div>
                            </form>

                            <form id="admin-page-bulk-form" method="post" action="{{ path('admin_page_bulk', app.request.query.all) }}" data-bulk-form>
                                <input type="hidden" name="token" value="{{ csrf_token('bulk_page') }}">
                                <div class="admin-bulk-toolbar">
                                    <select name="bulk_action" class="form-control">
                                        <option value="">Chọn thao tác</option>
                                        <option value="publish">Xuất bản</option>
                                        <option value="draft">Chuyển thành Nháp</option>
                                        <option value="trash">Chuyển vào thùng rác</option>
                                        <option value="delete">Xóa vĩnh viễn</option>
                                    </select>
                                    <button type="submit" class="btn btn-default">Áp dụng</button>
                                    <span class="text-muted">{{ pagination.getTotalItemCount }} {{ is_tree_mode ? 'trang gốc' : 'trang' }}</span>
                                </div>
                            </form>

                            <p class="page-tree-guide text-muted mb-2">
                                {{ is_tree_mode ? 'Trang con nằm ngay dưới trang cha và thụt vào theo cấp. Phân trang theo trang gốc, giữ trọn các trang con.' : 'Đang lọc danh sách; nhãn cấp và mục "Thuộc" giúp xác định vị trí của trang trong cây.' }}
                            </p>

                            <table class="table table-striped table-bordered admin-list-table">
                                    <thead>
                                        <tr>
                                            <th class="admin-list-check"><input type="checkbox" data-bulk-check-all></th>
                                            <th style="width: 80px;">Hình ảnh</th>
                                            <th>{{ 'label.title'|trans }} / Phân cấp</th>
                                            <th style="width: 130px;">{{ 'label.status'|trans }}</th>
                                            <th style="width: 120px;">{{ 'label.published_at'|trans }}</th>
                                            <th style="width: 100px;">{{ 'label.actions'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in pagination %}
                                            {{ include('admin/page/_tree_row.html.twig', {
                                                page: row,
                                                level: page_levels[row.id]|default(0),
                                                render_children: is_tree_mode,
                                                seen: []
                                            }, with_context = false) }}
                                        {% else %}
                                            <tr>
                                                <td colspan="6" class="text-center text-muted">Không tìm thấy trang.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                            </table>

                            <div class="admin-pagination">
                                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v3_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}

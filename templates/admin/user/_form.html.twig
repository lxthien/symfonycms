{{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.username) }}
    {{ form_row(form.name) }}
    {{ form_row(form.email) }}
    {% if form.enabled is defined %}
        {{ form_row(form.enabled) }}
    {% endif %}
    {{ form_row(form.roles) }}
    {% if form.plainPassword is defined %}
        {{ form_row(form.plainPassword) }}
    {% endif %}

    <button type="submit" class="btn btn-primary">
        <i class="fa fa-save" aria-hidden="true"></i> {{ button_label|default('Lưu user') }}
    </button>
    <a href="{{ path('admin_user_index') }}" class="btn btn-link">
        <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
    </a>

    {{ form_rest(form) }}
{{ form_end(form) }}

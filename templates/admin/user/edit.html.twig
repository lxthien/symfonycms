{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin-user-edit' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Chỉnh sửa user: {{ object.username }}</strong>
                            {% if is_super_admin %}
                                <a class="pull-right" href="{{ path('admin_user_password', {id: object.id}) }}">
                                    <i class="fa fa-key"></i> Đổi mật khẩu
                                </a>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            {{ include('admin/user/_form.html.twig', {
                                form: form,
                                button_label: 'Lưu user',
                            }, with_context = false) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_audit_log_index' %}

{% block main %}
    <div class="content mt-3 audit-log-page">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Audit log toàn hệ thống</strong>
                            <span class="badge badge-primary">{{ pagination.getTotalItemCount }}</span>
                        </div>
                        <div class="card-body">
                            <form class="admin-list-filters" method="get" action="{{ path('admin_audit_log_index') }}">
                                <div class="row">
                                    <div class="col-md-3">
                                        <input type="text" name="q" value="{{ filters.q }}" class="form-control" placeholder="Tìm entity, URL, IP">
                                    </div>
                                    <div class="col-md-2">
                                        <select name="action" class="form-control">
                                            <option value="">Tất cả action</option>
                                            {% for action in actions %}
                                                <option value="{{ action }}" {{ filters.action == action ? 'selected' : '' }}>{{ action }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <select name="entityType" class="form-control">
                                            <option value="">Tất cả entity</option>
                                            {% for entityType in entityTypes %}
                                                <option value="{{ entityType }}" {{ filters.entityType == entityType ? 'selected' : '' }}>{{ entityType }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="username" value="{{ filters.username }}" class="form-control" placeholder="User">
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Lọc</button>
                                        <a href="{{ path('admin_audit_log_index') }}" class="btn btn-link">Xóa lọc</a>
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table audit-log-table">
                                    <thead>
                                        <tr>
                                            <th>Thời điểm</th>
                                            <th>User</th>
                                            <th>Action</th>
                                            <th>Entity</th>
                                            <th>Thay đổi</th>
                                            <th>Request</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in pagination %}
                                            <tr>
                                                <td>
                                                    {{ row.createdAt|date('d/m/Y H:i:s') }}
                                                    <small class="d-block text-muted">{{ row.ip }}</small>
                                                </td>
                                                <td>
                                                    {{ row.username ?: 'System/anonymous' }}
                                                    {% if row.user %}
                                                        <small class="d-block text-muted">#{{ row.user.id }}</small>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <span class="badge badge-{{ row.action == 'delete' ? 'danger' : (row.action == 'create' ? 'success' : 'primary') }}">{{ row.action }}</span>
                                                </td>
                                                <td>
                                                    <strong>{{ row.entityType }}</strong>
                                                    {% if row.entityId %}
                                                        <small class="text-muted">#{{ row.entityId }}</small>
                                                    {% endif %}
                                                    <small class="d-block text-muted">{{ row.entityLabel }}</small>
                                                </td>
                                                <td>
                                                    {% set changes = row.changesData %}
                                                    {% if changes|length %}
                                                        <details>
                                                            <summary>{{ changes|length }} field</summary>
                                                            <div class="audit-change-list">
                                                                {% for field, change in changes %}
                                                                    <div class="audit-change-item">
                                                                        <strong>{{ field }}</strong>
                                                                        <div class="audit-change-values">
                                                                            <code>{{ change.old is defined ? change.old|json_encode(constant('JSON_UNESCAPED_UNICODE')) : 'null' }}</code>
                                                                            <span>→</span>
                                                                            <code>{{ change.new is defined ? change.new|json_encode(constant('JSON_UNESCAPED_UNICODE')) : 'null' }}</code>
                                                                        </div>
                                                                    </div>
                                                                {% endfor %}
                                                            </div>
                                                        </details>
                                                    {% else %}
                                                        <span class="text-muted">Không có field diff</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <small>{{ row.requestMethod }} {{ row.route }}</small>
                                                    <small class="d-block text-muted">{{ row.requestUri }}</small>
                                                    <small class="d-block text-muted">{{ row.userAgent }}</small>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="6" class="text-center text-muted">Chưa có audit log.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            <div class="admin-pagination">
                                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v3_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

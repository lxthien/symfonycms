{% if form.category is defined %}
    {% set primaryValue = form.categoryPrimary.vars.value|default('') %}

    <div class="form-group news-category-tree-field">
        {{ form_label(form.category) }}
        {{ form_errors(form.category) }}

        <div class="news-category-tree"
             data-category-tree
             data-primary-target="#{{ form.categoryPrimary.vars.id }}">
            {% for item in category_tree|default([]) %}
                {% set category = item.category %}
                {% set categoryField = attribute(form.category, category.id) %}
                {% set isChecked = categoryField.vars.checked|default(false) %}
                {% set isPrimary = primaryValue == category.id %}

                <div class="news-category-tree-row {{ item.depth == 0 ? 'is-parent' : 'is-child' }}"
                     style="--category-depth: {{ item.depth }}">
                    <label class="news-category-tree-check">
                        <span class="news-category-tree-indent"></span>
                        {% if item.depth > 0 %}
                            <i class="fa fa-file-text news-category-tree-file" aria-hidden="true"></i>
                        {% else %}
                            <i class="fa fa-folder news-category-tree-folder" aria-hidden="true"></i>
                        {% endif %}
                        <input type="checkbox"
                               id="{{ categoryField.vars.id }}"
                               name="{{ categoryField.vars.full_name }}"
                               value="{{ categoryField.vars.value }}"
                               class="news-category-checkbox"
                               data-category-id="{{ category.id }}"
                               {{ isChecked ? 'checked' : '' }}>
                        <span>{{ category.name }}</span>
                    </label>

                    <label class="news-category-tree-primary">
                        <input type="radio"
                               name="category_primary_choice"
                               value="{{ category.id }}"
                               class="news-category-primary-radio"
                               {{ isPrimary ? 'checked' : '' }}
                               {{ isChecked ? '' : 'disabled' }}>
                        Chọn làm danh mục chính
                    </label>
                </div>
            {% else %}
                <div class="text-muted">Chưa có danh mục.</div>
            {% endfor %}
        </div>
    </div>

    {% do form.category.setRendered %}
{% endif %}

{% set diff = revisionDiffs[revision.id]|default([]) %}

<div class="modal fade revision-compare-modal" id="revisionCompareModal{{ revision.id }}" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">So sánh revision #{{ revision.id }}</h4>
                <p class="text-muted">
                    Revision {{ revision.revisionType }} lúc {{ revision.createdAt|date('H:i:s d/m/Y') }}
                    bởi {{ revision.author ? revision.author.name : 'System' }}.
                </p>
            </div>
            <div class="modal-body">
                {% if diff %}
                    {% for item in diff %}
                        <div class="revision-diff-block">
                            <h4>{{ item.label }}</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <h5>Revision</h5>
                                    <pre>{{ item.left }}</pre>
                                </div>
                                <div class="col-md-6">
                                    <h5>Hiện tại</h5>
                                    <pre>{{ item.right }}</pre>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-success">Revision này giống nội dung hiện tại.</div>
                {% endif %}
            </div>
            <div class="modal-footer">
                <form method="post" action="{{ path('admin_news_revision_restore', {id: news.id, revisionId: revision.id}) }}" data-confirmation class="revision-restore-form">
                    <input type="hidden" name="token" value="{{ csrf_token('restore_revision_' ~ revision.id) }}">
                    <button type="submit" class="btn btn-warning" data-toggle="modal" data-target="#confirmationModalRestoreCompare{{ revision.id }}">
                        <i class="fa fa-history"></i> Khôi phục revision này
                    </button>
                </form>
                <button type="button" class="btn btn-link" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

{{ include('admin/news/_restore_confirmation.html.twig', {id: 'RestoreCompare' ~ revision.id}) }}

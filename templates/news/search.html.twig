{% extends 'layout.html.twig' %}

{% block title %}{% if q %}{{ 'post.archives.title'|trans({'%title%': q, '%currentPage%': pagination.currentPageNumber, '%totalPage%': pagination.pageCount}) }}{% else %}Tìm kiếm | {{ get_setting('siteName') }}{% endif %}{% endblock %}

{% block robots %}
    <meta name="robots" content="noindex,follow" />
{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:type" content="object" />
    <meta property="og:title" content="{{ 'post.archives.title'|trans({'%title%': q, '%currentPage%': pagination.currentPageNumber, '%totalPage%': pagination.pageCount}) }}" />
    <meta property="og:image" content="{{ absolute_url(convert_images.webpConvert2(asset('/assets/images/xaydungminhduy-2.jpg'), '')) }}" />
    <meta property="og:image:alt" content="{{ 'post.archives.title'|trans({'%title%': q, '%currentPage%': pagination.currentPageNumber, '%totalPage%': pagination.pageCount}) }}" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
    {% if pagination.currentPageNumber == 1 and pagination.pageCount > 1 %}
        <link rel="next" href="{{ baseUrl ~ '&page=' ~ (pagination.currentPageNumber + 1) }}" />
    {% endif %}
    {% if pagination.currentPageNumber > 1 and pagination.currentPageNumber < pagination.pageCount %}
        <link rel="prev" href="{{ baseUrl ~ '&page=' ~ (pagination.currentPageNumber - 1) }}" />
        <link rel="next" href="{{ baseUrl ~ '&page=' ~ (pagination.currentPageNumber + 1) }}" />
    {% endif %}
    {% if pagination.currentPageNumber == pagination.pageCount and pagination.pageCount > 1 %}
        <link rel="prev" href="{{ baseUrl ~ '&page=' ~ (pagination.currentPageNumber - 1) }}" />
    {% endif %}
{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ baseUrl }}"/>
{% endblock %}

{% block body %}
    {# breadcrumbs #}
    {{ include('news/components/breadcrumbs.html.twig', {
        type: 'category',
        title: q ? 'Kết quả tìm kiếm cho từ khoá: "' ~ q ~ '"' : 'Tìm kiếm',
        description: (q ? 'Tìm thấy ' ~ pagination.getTotalItemCount ~ ' bài viết phù hợp với từ khoá “' ~ q ~ '”.' : 'Tìm dịch vụ, báo giá và kinh nghiệm xây nhà bạn cần.')|e
    }) }}

    <style>
        .search-page__form { max-width: 720px; margin: 20px auto 30px; }
        .search-page__form label { display: block; font-weight: 600; margin-bottom: 8px; }
        .search-page__fields { display: flex; gap: 10px; }
        .search-page__fields input { flex: 1; min-width: 0; height: 46px; padding: 0 14px; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; }
        .search-page__fields button { height: 46px; padding: 0 22px; border: 0; border-radius: 6px; background: #f39c12; color: #fff; font-weight: 600; }
        .search-page__empty { text-align: center; padding: 30px 15px 50px; }
        .search-page__empty h2 { font-size: 22px; margin-bottom: 10px; }
        .search-view mark, .list-news-items mark { background: #fff3a3; color: inherit; padding: 0 2px; border-radius: 2px; }
    </style>

    <div class="container wrapper-container">
        <form class="search-page__form" action="{{ path('news_search') }}" method="get" role="search">
            <label for="search-query">Bạn muốn tìm nội dung gì?</label>
            <div class="search-page__fields">
                <input id="search-query" type="search" name="q" value="{{ q }}" placeholder="Ví dụ: chi phí xây nhà" required maxlength="200" enterkeyhint="search">
                <button type="submit"><i class="fas fa-search"></i> Tìm kiếm</button>
            </div>
        </form>

        <div class="row category-list-items">
            <div class="col-12 col-md-12 col-lg-12">
                {# List item on this page #}
                {% if pagination|length > 0  %}
                    {# Sort items #}
                    {% if get_setting('isShowSortOnCategory') %}
                        {{ include('news/components/sort.html.twig') }}
                    {% endif %}

                    <div class="list-news-items">
                        <div class="row">
                            {% for row in pagination %}
                                {{ include('news/components/itemsGrid.html.twig') }}
                            {% endfor %}
                        </div>
                    </div>

                    {# Pagination #}
                    {{ include('news/components/pagination.html.twig') }}
                {% elseif q %}
                    <div class="search-page__empty">
                        <h2>Chưa tìm thấy nội dung phù hợp</h2>
                        <p>Hãy thử từ khóa ngắn hơn, kiểm tra chính tả hoặc tìm theo chủ đề như “xây nhà”, “báo giá”, “thiết kế”.</p>
                        <a class="btn btn-primary" href="{{ path('homepage') }}">Về trang chủ</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
<div class="sort-wrapper">
    <div class="sort-dropdown">
        <button class="sort-btn" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-sort-amount-down"></i>
            <span>{{'Sắp xếp'|trans}}</span>
            <i class="fas fa-chevron-down"></i>
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            {{ knp_pagination_sortable(pagination, 'Mới nhất'|trans, 'createdAt', {'direction': 'desc'}) }}
            {{ knp_pagination_sortable(pagination, 'Cũ nhất'|trans, 'createdAt', {'direction': 'asc'}) }}
            {{ knp_pagination_sortable(pagination, 'Tên A-Z'|trans, 'name', {'direction': 'asc'}) }}
            {{ knp_pagination_sortable(pagination, 'Tên Z-A'|trans, 'name', {'direction': 'desc'}) }}
        </div>
    </div>
</div>